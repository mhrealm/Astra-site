---
interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<button
  class:list={['theme-toggle', { 'theme-toggle--compact': compact }]}
  type="button"
  data-theme-toggle
  aria-label="切换主题"
  title="切换主题"
>
  <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
  </svg>
</button>

<script>
  const initToggle = (button: HTMLButtonElement) => {
    const applyIcons = () => {
      const isLight = document.documentElement.getAttribute('data-theme') === 'light'
      button.setAttribute('aria-label', isLight ? '切换到深色主题' : '切换到浅色主题')
      button.setAttribute('title', isLight ? '切换到深色主题' : '切换到浅色主题')
    }

    button.addEventListener('click', () => {
      const next = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
      document.documentElement.setAttribute('data-theme', next)
      try {
        localStorage.setItem('theme', next)
      } catch (e) {
        /* 无痕模式下存储不可用时，切换仍对当前页面生效 */
      }
      applyIcons()
    })

    applyIcons()
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(initToggle)
</script>

<style>
  .theme-toggle {
    align-items: center;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    padding: 0;
    transition: color 0.2s ease, transform 0.2s ease;
    width: 2rem;
  }

  .theme-toggle:hover {
    color: var(--text-bright);
    transform: rotate(15deg);
  }

  /* 深色下显示太阳（点击去浅色），浅色下显示月亮（点击去深色） */
  .theme-toggle .icon-sun {
    display: block;
  }
  .theme-toggle .icon-moon {
    display: none;
  }
  :global(html[data-theme='light']) .theme-toggle .icon-sun {
    display: none;
  }
  :global(html[data-theme='light']) .theme-toggle .icon-moon {
    display: block;
  }

  .theme-toggle--compact {
    height: 1.75rem;
    width: 1.75rem;
  }
</style>
