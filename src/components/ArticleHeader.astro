---
import { SITE_TITLE } from '../consts'
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname
const nav = [
  { label: '博客', href: '/blog', active: pathname.startsWith('/blog') },
  { label: '项目', href: '/projects', active: pathname.startsWith('/projects') },
  { label: '关于', href: '/about', active: pathname.startsWith('/about') },
]
---

<header class="article-header">
  <nav aria-label="顶部导航">
    <a class="brand" href="/" aria-label="回到首页">
      <span class="brand-mark"><img src="/avatar.jpg" alt="" /></span>
      <span class="brand-name">{SITE_TITLE} の Blog</span>
    </a>

    <div class="nav-links">
      {nav.map((item) => (
        <a
          href={item.href}
          class={item.active ? 'active' : ''}
        >{item.label}</a>
      ))}
    </div>

    <div class="social-links">
      <a href="mailto:hello@example.com" aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 7.5 12 13l7.5-5.5M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5Z"></path>
        </svg>
      </a>
      <a href="https://github.com/mhrealm" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .article-header {
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  nav {
    align-items: center;
    display: flex;
    gap: 1.5rem;
    height: 60px;
    margin: 0 auto;
    max-width: 1200px;
    padding: 0 16px;
    width: 100%;
  }

  .brand {
    align-items: center;
    color: var(--text-bright);
    display: inline-flex;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand-mark {
    background: #ffffff;
    border-radius: 6px;
    display: block;
    height: 2rem;
    overflow: hidden;
    width: 2rem;
  }

  .brand-mark img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .nav-links {
    align-items: center;
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--text-bright);
  }

  .social-links {
    align-items: center;
    border-left: 1px solid var(--border);
    display: flex;
    gap: 0.35rem;
    padding-left: 1rem;
  }

  .social-links a {
    align-items: center;
    color: var(--muted);
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    transition: color 0.2s ease;
    width: 2rem;
  }

  .social-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    nav {
      gap: 0.75rem;
      padding: 0 12px;
    }
    .brand-name {
      display: none;
    }
    .nav-links {
      gap: 1rem;
    }
    .nav-links a {
      font-size: 0.86rem;
    }
    .social-links {
      display: none;
    }
  }
</style>
