---
import type { DemoEntry } from '../data/demos'
import DemoMount from './DemoMount.vue'
import ReactDemoMount from './ReactDemoMount'

interface Props {
  demo: DemoEntry
}

const { demo } = Astro.props
---

{
  demo.framework === 'react' ? (
    <ReactDemoMount componentPath={demo.componentPath} client:only="react" />
  ) : (
    <DemoMount componentPath={demo.componentPath} client:only="vue" />
  )
}
