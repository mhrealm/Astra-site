---
import type { CollectionEntry } from 'astro:content'
import { getBlogSlug } from '../data/blogSlugs'
import FormattedDate from './FormattedDate.astro'

interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

{
  posts.length > 0 && (
    <section class="related-card" aria-labelledby="related-posts-title">
      <div class="related-head">
        <h2 id="related-posts-title">往期精彩</h2>
      </div>
      <div class="related-list">
        {posts.map((post) => {
          const slug = getBlogSlug(post)

          return (
            <a class="related-link" href={`/blog/${slug}/`}>
              <span class="related-title">{post.data.title}</span>
              <span class="related-meta">
                <FormattedDate date={post.data.pubDate} />
                <span aria-hidden="true">·</span>
                <span>{post.data.category}</span>
              </span>
            </a>
          )
        })}
      </div>
    </section>
  )
}

<style>
  .related-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    box-shadow: var(--box-shadow);
    overflow: hidden;
    padding: 0 18px 14px;
  }

  .related-head {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    height: 64px;
  }

  h2 {
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
  }

  .related-list {
    max-height: 260px;
    overflow-y: auto;
    padding: 12px 6px 0 0;
    scrollbar-color: #cfd4dc transparent;
    scrollbar-width: thin;
  }

  .related-list::-webkit-scrollbar {
    width: 6px;
  }

  .related-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .related-list::-webkit-scrollbar-thumb {
    background: #d8dce3;
    border-radius: 999px;
  }

  .related-list::-webkit-scrollbar-thumb:hover {
    background: #c6cbd4;
  }

  .related-link {
    color: var(--text);
    display: block;
    padding: 0.7rem 0;
    text-decoration: none;
  }

  .related-link + .related-link {
    border-top: 1px solid var(--border-soft);
  }

  .related-title {
    color: var(--text);
    display: -webkit-box;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.45;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 160ms ease;
  }

  .related-link:hover .related-title {
    color: var(--accent);
  }

  .related-meta {
    align-items: center;
    color: var(--muted-soft);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.78rem;
    font-weight: 600;
    gap: 0.42rem;
    line-height: 1.4;
    margin-top: 0.32rem;
  }
</style>
