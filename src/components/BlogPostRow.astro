---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import PlaceholderImage from '../assets/blog-placeholder-3.jpg'
import { getBlogSlug } from '../data/blogSlugs'
import { getPostThumbnail } from '../data/postThumbnails'
import DifficultyStars from './DifficultyStars.astro'
import FormattedDate from './FormattedDate.astro'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const tags = post.data.tags ?? []
const slug = getBlogSlug(post)
const thumbnail = getPostThumbnail(slug) ?? post.data.heroImage ?? PlaceholderImage
---

<a class="post-row" href={`/blog/${slug}/`}>
  <div class="post-content">
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="meta-line">
      <span class="meta-item"><FormattedDate date={post.data.pubDate} /></span>
      {
        post.data.difficulty && (
          <span class="meta-item">
            <DifficultyStars value={post.data.difficulty} />
          </span>
        )
      }
      {tags.map((tag) => <span class="meta-item tag">{tag}</span>)}
    </div>
  </div>
  <div class="post-thumb" aria-hidden="true">
    <Image src={thumbnail} width={132} height={88} alt="" loading="lazy" />
  </div>
</a>

<style>
  .post-row {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    color: var(--text);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr) 132px;
    min-height: 120px;
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .post-row:first-child {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
  }
  .post-row:last-child {
    border-bottom: 0;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
  }
  .post-row:hover {
    background: var(--surface-raised);
    color: var(--text);
  }

  .post-content {
    align-self: center;
    min-width: 0;
  }

  .meta-line {
    align-items: center;
    color: var(--muted-soft);
    display: flex;
    flex-wrap: nowrap;
    font-size: 0.82rem;
    font-weight: 600;
    gap: 0.55rem;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .meta-item {
    align-items: center;
    display: inline-flex;
    flex: 0 0 auto;
    min-width: 0;
  }

  .meta-item:not(:last-child)::after {
    color: #c2c8d1;
    content: '|';
    margin-left: 0.55rem;
  }
  h3 {
    color: var(--text-bright);
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 0 0.42rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  p {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.55;
    margin: 0 0 0.62rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag {
    color: var(--muted);
  }

  .post-thumb {
    align-self: center;
    border-radius: 6px;
    height: 85px;
    overflow: hidden;
  }

  .post-thumb img {
    display: block;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
    width: 100%;
  }

  .post-row:hover .post-thumb img {
    transform: scale(1.04);
  }

  @media (max-width: 720px) {
    .post-row {
      gap: 1rem;
      grid-template-columns: minmax(0, 1fr) 108px;
      min-height: 104px;
      padding: 0.9rem 1rem;
    }

    .post-thumb {
      height: 72px;
    }

    h3 {
      margin-bottom: 0.32rem;
    }

    p {
      font-size: 0.86rem;
      margin-bottom: 0.45rem;
    }
  }

  @media (max-width: 440px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-thumb {
      display: none;
    }
  }
</style>
