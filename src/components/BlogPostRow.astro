---
import type { CollectionEntry } from 'astro:content'
import { getBlogSlug } from '../data/blogSlugs'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const slug = getBlogSlug(post)
const date = post.data.pubDate
const dateLabel = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`

// 按正文字符数估算阅读时长（约 400 字/分钟，最少 1 分钟）
const charCount = (post.body ?? '').length
const minutes = Math.max(1, Math.round(charCount / 400))
---

<div class="archive-item">
  <time datetime={date.toISOString()}>{dateLabel}</time>
  <a class="archive-title" href={`/blog/${slug}`}>{post.data.title}</a>
  <span class="archive-minutes">约 {minutes} 分钟</span>
  <a
    class="archive-category"
    href={`/blog/category/${post.data.categorySlug ?? 'uncategorized'}`}
  >
    {post.data.category}
  </a>
</div>

<style>
  .archive-item {
    align-items: center;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    display: grid;
    gap: 1rem;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto auto;
    padding: 0.9rem 0;
    position: relative;
    transition:
      color 0.2s,
      padding-left 0.25s ease;
  }
  .archive-item:hover {
    color: var(--muted);
    padding-left: 0.5rem;
  }
  .archive-item time {
    color: var(--muted-soft);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .archive-title {
    color: inherit;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    min-width: 0;
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .archive-title::after {
    content: '';
    inset: 0;
    position: absolute;
    z-index: 1;
  }
  .archive-category {
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.72rem;
    padding: 0.15rem 0.5rem;
    position: relative;
    text-decoration: none;
    white-space: nowrap;
    z-index: 2;
  }
  .archive-category:hover {
    color: var(--accent);
  }
  .archive-minutes {
    color: var(--muted-soft);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .archive-item {
      gap: 0.25rem;
      grid-template-columns: 1fr;
      padding: 1rem 0;
    }
    .archive-title {
      white-space: normal;
    }
    .archive-category {
      width: fit-content;
    }
    .archive-minutes {
      display: none;
    }
  }
</style>
