---
import { SITE_TITLE } from '../consts'
import ThemeToggle from './ThemeToggle.astro'

const pathname = Astro.url.pathname

const nav = [
  { label: '博客', href: '/blog', active: pathname.startsWith('/blog') },
  { label: '项目', href: '/projects', active: pathname.startsWith('/projects') },
  { label: '关于', href: '/about', active: pathname.startsWith('/about') },
]

const year = new Date().getFullYear()
---

<!-- 桌面端左侧固定侧栏 -->
<aside class="sidebar" id="site-sidebar" aria-label="主导航">
  <div class="sidebar-brand">
    <a href="/" class="sidebar-avatar" aria-label="回到首页">
      <img src="/avatar.jpg" alt="作者头像" />
    </a>
    <div class="sidebar-identity">
      <div class="sidebar-name">{SITE_TITLE} の Blog</div>
      <div class="sidebar-role">Web Frontend Engineer</div>
    </div>

    <nav class="sidebar-nav" aria-label="主导航">
      {nav.map((item) => (
        <a
          href={item.href}
          class={item.active ? 'active' : ''}
        >{item.label}</a>
      ))}
    </nav>
  </div>

  <div class="sidebar-foot">
    <div class="sidebar-links">
      <a href="mailto:hello@example.com" aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.5 7.5 12 13l7.5-5.5M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5Z"></path>
        </svg>
      </a>
      <a href="https://github.com/mhrealm" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <ThemeToggle compact />
    </div>
    <div class="sidebar-meta">
      <div class="sidebar-copyright">© {year} {SITE_TITLE}</div>
    </div>
  </div>
</aside>

<!-- 移动端顶部栏 -->
<header class="mobile-header">
  <div class="mobile-header-inner">
    <a href="/" class="mobile-brand">{SITE_TITLE} の Blog</a>
    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="打开菜单" aria-expanded="false" aria-controls="site-sidebar">☰</button>
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn')
  const sidebar = document.getElementById('site-sidebar')

  const close = () => {
    sidebar?.classList.remove('is-open')
    btn?.setAttribute('aria-expanded', 'false')
  }

  btn?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('is-open')
    btn?.setAttribute('aria-expanded', String(Boolean(open)))
  })

  sidebar?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close()
  })
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-w);
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2.25rem 1.75rem;
    border-right: 1px solid var(--border);
    background: var(--bg);
    overflow-y: auto;
    scrollbar-width: thin;
    z-index: 100;
  }
  .sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .sidebar::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 4px;
  }
  .sidebar-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sidebar-avatar {
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
    display: block;
    flex-shrink: 0;
  }
  .sidebar-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sidebar-identity {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .sidebar-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-bright);
    line-height: 1.2;
  }
  .sidebar-role {
    color: var(--muted-soft);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .sidebar-nav a {
    position: relative;
    font-size: 0.92rem;
    color: var(--muted);
    padding: 0.3rem 0;
    transition: color 0.25s ease;
    width: fit-content;
  }
  .sidebar-nav a::after {
    content: '';
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.35s ease;
  }
  .sidebar-nav a:hover,
  .sidebar-nav a.active {
    color: var(--text-bright);
  }
  .sidebar-nav a:hover::after,
  .sidebar-nav a.active::after {
    width: 100%;
  }
  .sidebar-foot {
    font-size: 0.7rem;
    color: var(--muted-soft);
    line-height: 1.6;
    flex-shrink: 0;
  }
  .sidebar-links {
    align-items: center;
    display: flex;
    gap: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .sidebar-links a {
    align-items: center;
    color: var(--muted);
    display: inline-flex;
    height: 1.75rem;
    justify-content: center;
    transition: color 0.2s ease;
    width: 1.75rem;
  }
  .sidebar-links a svg {
    height: 17px;
    width: 17px;
  }
  .sidebar-links a:hover {
    color: var(--text-bright);
  }
  .sidebar-meta > div {
    white-space: nowrap;
  }

  .mobile-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem var(--wrap-pad);
    background: var(--header-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .mobile-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
  }
  .mobile-brand {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-bright);
  }
  .mobile-menu-btn {
    background: transparent;
    border: none;
    color: var(--text-bright);
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
    .sidebar.is-open {
      display: flex;
      position: fixed;
      width: 100vw;
      height: 100vh;
      padding-top: 5rem;
      z-index: 200;
      border-right: none;
    }
    .mobile-header {
      display: block;
    }
  }
</style>
