---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">YN</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>Web Frontend Engineer</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/demos">演示</HeaderLink>
			<HeaderLink href="/#projects">项目</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="social-links">
			<a class="icon-link" href="mailto:hello@example.com" aria-label="Email">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path
						fill="none"
						stroke="currentColor"
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="1.8"
						d="M4.5 7.5 12 13l7.5-5.5M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5Z"></path>
				</svg>
			</a>
			<a class="icon-link" href="https://github.com/" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		backdrop-filter: blur(16px) saturate(150%);
		background: rgba(255, 255, 255, 94%);
		border-bottom: 1px solid var(--border);
		box-shadow: 0 1px 2px rgba(29, 33, 41, 3%);
		margin: 0;
		position: sticky;
		top: 0;
		z-index: 50;
	}
	.brand {
		align-items: center;
		color: var(--text);
		display: inline-flex;
		gap: 0.75rem;
		text-decoration: none;
	}
	.brand:hover strong {
		color: var(--accent-strong);
	}
	.brand-mark {
		align-items: center;
		aspect-ratio: 1;
		background: var(--accent);
		border: 1px solid rgba(30, 128, 255, 18%);
		border-radius: 999px;
		color: white;
		display: inline-flex;
		font-size: 0.78rem;
		font-weight: 800;
		justify-content: center;
		width: 2.5rem;
	}
	.brand-copy {
		display: grid;
		line-height: 1.15;
	}
	.brand-copy strong {
		color: var(--text);
		font-size: 0.98rem;
		transition: color 180ms ease;
	}
	.brand-copy small {
		color: var(--muted);
		font-size: 0.76rem;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 4.25rem;
		margin: 0 auto;
		max-width: 1120px;
		padding: 0 1rem;
	}
	.internal-links {
		align-items: center;
		display: flex;
		gap: 0.25rem;
		margin-left: auto;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		align-items: center;
		border-left: 1px solid var(--border);
		gap: 0.35rem;
		padding-left: 1rem;
	}
	.icon-link {
		align-items: center;
		border: 1px solid transparent;
		border-radius: 8px;
		color: var(--muted);
		height: 2.5rem;
		justify-content: center;
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
		width: 2.5rem;
	}
	.icon-link:hover {
		background: var(--surface-raised);
		border-color: var(--border);
		color: var(--accent);
		transform: translateY(-1px);
	}
	@media (max-width: 720px) {
		nav {
			gap: 0.8rem;
			height: auto;
			padding: 0.75rem 1rem;
		}
		.brand-copy small {
			display: none;
		}
		.internal-links {
			gap: 0;
			overflow-x: auto;
			padding: 0.2rem 0;
		}
		.social-links {
			display: none;
		}
	}
	@media (max-width: 520px) {
		nav {
			align-items: flex-start;
			flex-direction: column;
		}
		.internal-links {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
