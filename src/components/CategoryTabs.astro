---
interface CategoryTabItem {
  label: string
  count?: number
  href?: string
  value?: string
  active?: boolean
  id?: string
  controls?: string
}

interface Props {
  items: CategoryTabItem[]
  ariaLabel: string
  mode?: 'link' | 'button'
}

const { items, ariaLabel, mode = 'link' } = Astro.props
const isButtonMode = mode === 'button'
---

<nav class="category-tabs" aria-label={ariaLabel} role={isButtonMode ? 'tablist' : undefined}>
  {
    items.map((item) =>
      isButtonMode ? (
        <button
          id={item.id}
          type="button"
          class:list={['category-tab', { 'is-active': item.active }]}
          role="tab"
          aria-selected={item.active ? 'true' : 'false'}
          aria-controls={item.controls}
          tabindex={item.active ? 0 : -1}
          data-category-tab={item.value}
        >
          <span>{item.label}</span>
          {typeof item.count === 'number' && <small>{item.count}</small>}
        </button>
      ) : (
        <a
          href={item.href ?? '#'}
          class:list={['category-tab', { 'is-active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          <span>{item.label}</span>
          {typeof item.count === 'number' && <small>{item.count}</small>}
        </a>
      ),
    )
  }
</nav>

<style>
  .category-tabs {
    align-items: center;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    border-radius: 6px;
    display: flex;
    gap: 0;
    margin: 0 0 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 0.5rem;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .category-tabs::-webkit-scrollbar {
    display: none;
  }

  .category-tab {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 auto;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    gap: 0.35rem;
    line-height: 1;
    min-height: 4rem;
    padding: 0 1.35rem;
    position: relative;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .category-tab::after {
    background: var(--accent);
    border-radius: 999px;
    bottom: -1px;
    content: '';
    height: 3px;
    left: 50%;
    opacity: 0;
    position: absolute;
    transform: translateX(-50%);
    width: 2rem;
  }

  .category-tab:hover {
    color: var(--text);
  }

  .category-tab.is-active {
    color: var(--text);
    font-weight: 500;
  }

  .category-tab.is-active::after {
    opacity: 1;
  }

  small {
    color: var(--muted-soft);
    font-size: 0.9em;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .category-tabs {
      margin-bottom: 1rem;
      padding: 0 0.25rem;
    }

    .category-tab {
      min-height: 3.5rem;
      padding: 0 1rem;
    }
  }
</style>
