---
import type { CategorySummary } from '../data/categories'
import CategoryTabs from './CategoryTabs.astro'

interface Props {
  categories: CategorySummary[]
  total: number
  active?: string
}

const { categories, total, active = 'all' } = Astro.props
const items = [
  {
    label: '全部',
    count: total,
    href: '/blog/',
    active: active === 'all',
  },
  ...categories.map((category) => ({
    label: category.name,
    count: category.count,
    href: `/blog/category/${category.slug}/`,
    active: active === category.slug,
  })),
]
---

<CategoryTabs items={items} ariaLabel="文章分类" />
