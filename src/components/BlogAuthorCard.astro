---
interface Props {
  name: string
  postCount: number
  readCount: number
}

const { name, postCount, readCount } = Astro.props
---

<section class="author-card" aria-label="作者信息">
  <div class="author-top">
    <a href="/about" class="author-avatar" aria-label="关于作者">
      <img src="/avatar.jpg" alt="作者头像" />
    </a>
    <div class="author-info">
      <a href="/about" class="author-name">{name}</a>
      <span class="author-role">Web Frontend Engineer</span>
    </div>
  </div>

  <div class="author-stats">
    <div class="stat">
      <strong>{postCount}</strong>
      <span>文章</span>
    </div>
    <div class="stat">
      <strong>{readCount >= 1000 ? `${(readCount / 1000).toFixed(1)}k` : readCount}</strong>
      <span>阅读</span>
    </div>
  </div>
</section>

<style>
  .author-card {
    background: var(--surface);
    border-radius: 6px;
    box-shadow: var(--box-shadow);
    overflow: hidden;
    padding: 18px;
  }

  .author-top {
    align-items: center;
    display: flex;
    gap: 0.75rem;
  }

  .author-avatar {
    background: #ffffff;
    border-radius: 6px;
    display: block;
    flex-shrink: 0;
    height: 3rem;
    overflow: hidden;
    width: 3rem;
  }

  .author-avatar img {
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .author-name {
    color: var(--text-bright);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }

  .author-name:hover {
    color: var(--accent);
  }

  .author-role {
    color: var(--muted-soft);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  .author-stats {
    display: flex;
    gap: 2rem;
    margin: 1.1rem 0 0;
  }

  .stat {
    align-items: baseline;
    display: flex;
    gap: 0.35rem;
  }

  .stat strong {
    color: var(--text-bright);
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
  }

  .stat span {
    color: var(--muted-soft);
    font-size: 0.78rem;
  }
</style>
