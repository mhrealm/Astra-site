---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import HeroImage from '../assets/blog-placeholder-about.jpg';
import ProjectImageOne from '../assets/blog-placeholder-1.jpg';
import ProjectImageTwo from '../assets/blog-placeholder-2.jpg';
import ProjectImageThree from '../assets/blog-placeholder-5.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getBlogSlug } from '../data/blogSlugs';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const skills = [
	{ label: 'React', color: '#38bdf8' },
	{ label: 'Vue', color: '#34d399' },
	{ label: 'TypeScript', color: '#60a5fa' },
	{ label: 'Astro', color: '#f472b6' },
	{ label: 'Tailwind', color: '#22d3ee' },
	{ label: 'Cloudflare', color: '#f97316' },
	{ label: 'Shopify', color: '#22c55e' },
	{ label: 'AI / LLM', color: '#a78bfa' },
	{ label: 'Markdown', color: '#f59e0b' },
];

const stats = [
	{ label: '内容专题', value: '12', note: '长期整理' },
	{ label: '技术文章', value: '80+', note: '持续写作' },
	{ label: '项目案例', value: '8', note: '从想法到上线' },
	{ label: '技术方向', value: '6', note: '前端与云服务' },
];

const platforms = [
	{
		name: '微信公众号',
		handle: '@你的技术账号',
		description: '沉淀工程经验、独立站实践与 AI 编程观察。',
		metric: '文章 / 观点 / 案例',
	},
	{
		name: '掘金',
		handle: '@your-name',
		description: '发布前端专题、源码阅读和浏览器新能力笔记。',
		metric: '前端 / 性能 / CSS',
	},
	{
		name: 'GitHub',
		handle: '@your-name',
		description: '存放项目源码、实验工具和学习型仓库。',
		metric: 'Portfolio / Notes',
	},
];

const projects = [
	{
		kicker: 'Personal Website',
		title: '个人技术主页',
		description: '基于 Astro 的响应式主页，聚合文章、项目、平台矩阵和个人影响力。',
		tags: ['Astro', 'MDX', 'CSS'],
		image: ProjectImageOne,
	},
	{
		kicker: 'Learning Notes',
		title: '工程学习笔记',
		description: '用 Markdown 管理前端、云服务、自动化和效率工具的学习记录。',
		tags: ['Markdown', 'Vite', 'Cloudflare'],
		image: ProjectImageTwo,
	},
	{
		kicker: 'Edge Toolkit',
		title: '边缘应用实验室',
		description: '围绕 Workers、Serverless 和 API 编排做的小型工具集合。',
		tags: ['Workers', 'API', 'TypeScript'],
		image: ProjectImageThree,
	},
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-page">
			<section class="hero-section" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">Web Frontend Engineer</p>
					<h1 id="hero-title">
						Hi, I'm <span>Your Name</span><br />
						<small>Frontend Engineer</small>
					</h1>
					<p class="hero-description">
						我专注于构建高性能、可维护的 Web 产品，长期关注现代前端工程、独立站体验、
						边缘计算与 AI 编程工作流。
					</p>
					<div class="skill-list" aria-label="技术栈">
						{
							skills.map((skill) => (
								<span class="skill-pill">
									<span class="skill-dot" style={`--dot: ${skill.color}`}></span>
									{skill.label}
								</span>
							))
						}
					</div>
					<div class="hero-actions">
						<a class="button button-primary" href="mailto:hello@example.com">
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									fill="none"
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="1.8"
									d="M4.5 7.5 12 13l7.5-5.5M5.5 5h13A2.5 2.5 0 0 1 21 7.5v9A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5v-9A2.5 2.5 0 0 1 5.5 5Z"></path>
							</svg>
							Say Hello
						</a>
						<a class="button button-secondary" href="https://github.com/" target="_blank" rel="noopener noreferrer">
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
							</svg>
							View GitHub
						</a>
					</div>
				</div>
				<div class="hero-visual" aria-hidden="true">
					<div class="avatar-orbit"></div>
					<div class="avatar-frame">
						<Image src={HeroImage} width={320} height={320} alt="" loading="eager" />
					</div>
				</div>
			</section>

			<section id="writing" class="section-block" aria-labelledby="writing-title">
				<div class="section-heading">
					<p class="eyebrow">Writing</p>
					<h2 id="writing-title">我的最新博客</h2>
					<p>技术分享、开发心得、学习笔记</p>
				</div>
				<div class="post-grid">
					{
						posts.map((post) => (
							<a class="post-card" href={`/blog/${getBlogSlug(post)}/`}>
								{post.data.heroImage && (
									<Image width={720} height={405} src={post.data.heroImage} alt="" />
								)}
									<div class="card-body">
										<p class="post-date">
											<span>{post.data.category}</span>
											<span aria-hidden="true">/</span>
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</div>
							</a>
						))
					}
				</div>
				<div class="section-action">
					<a class="text-link" href="/blog">查看全部文章</a>
				</div>
			</section>

			<section class="section-block" aria-labelledby="impact-title">
				<div class="section-heading">
					<p class="eyebrow">Achievements</p>
					<h2 id="impact-title">成就与影响力</h2>
					<p>用长期内容输出，沉淀可量化的技术影响力</p>
				</div>
				<div class="stats-grid">
					{
						stats.map((item) => (
							<div class="stat-card">
								<span>{item.label}</span>
								<strong>{item.value}</strong>
								<small>{item.note}</small>
							</div>
						))
					}
				</div>
				<div class="platform-grid">
					{
						platforms.map((platform) => (
							<article class="platform-card">
								<div class="platform-mark" aria-hidden="true">{platform.name.slice(0, 1)}</div>
								<div>
									<h3>{platform.name}</h3>
									<p class="handle">{platform.handle}</p>
									<p>{platform.description}</p>
									<span>{platform.metric}</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="projects" class="section-block" aria-labelledby="projects-title">
				<div class="section-heading">
					<p class="eyebrow">Portfolio</p>
					<h2 id="projects-title">精选项目</h2>
					<p>从内容系统到产品实验，把工程能力落到具体作品里</p>
				</div>
				<div class="project-grid">
					{
						projects.map((project) => (
							<article class="project-card">
								<Image src={project.image} width={720} height={405} alt={project.title} />
								<div class="card-body">
									<span class="project-kicker">{project.kicker}</span>
									<h3>{project.title}</h3>
									<p>{project.description}</p>
									<div class="mini-tags">
										{project.tags.map((tag) => (
											<span>{tag}</span>
										))}
									</div>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		--home-inline: max(16px, calc((100% - 1120px) / 2));
		background-color: #f2f3f5;
		max-width: 100%;
		padding-top: 0;
		width: 100%;
	}
	.hero-section {
		align-items: center;
		background: linear-gradient(180deg, #ffffff 0%, #fbfcfd 100%);
		border-bottom: 1px solid #dfe3eb;
		display: grid;
		gap: 5rem;
		grid-template-columns: minmax(0, 1fr) 320px;
		margin: 0;
		min-height: 680px;
		padding: 72px var(--home-inline) 88px;
		width: 100%;
	}
	.eyebrow {
		color: var(--accent);
		font-size: 0.84rem;
		font-weight: 800;
		letter-spacing: 0;
		margin: 0 0 0.85rem;
		text-transform: uppercase;
	}
	.hero-copy h1 {
		font-size: 3.75rem;
		line-height: 1.12;
		margin-bottom: 1.5rem;
	}
	.hero-copy h1 span {
		color: var(--accent);
	}
	.hero-copy h1 small {
		color: var(--muted);
		font-size: 2.45rem;
		font-weight: 800;
	}
	.hero-description {
		color: var(--muted);
		font-size: 1.08rem;
		line-height: 1.85;
		margin-bottom: 1.6rem;
		max-width: 620px;
	}
	.skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-bottom: 2rem;
		max-width: 680px;
	}
	.skill-pill {
		align-items: center;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text);
		display: inline-flex;
		font-size: 0.82rem;
		font-weight: 700;
		gap: 0.45rem;
		line-height: 1;
		padding: 0.55rem 0.8rem;
	}
	.skill-dot {
		background: var(--dot);
		border-radius: 999px;
		box-shadow: 0 0 14px color-mix(in srgb, var(--dot) 45%, transparent);
		height: 0.44rem;
		width: 0.44rem;
	}
	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}
	.button {
		align-items: center;
		border-radius: 8px;
		display: inline-flex;
		font-weight: 800;
		gap: 0.55rem;
		min-height: 3rem;
		padding: 0.85rem 1.1rem;
		text-decoration: none;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			color 180ms ease,
			transform 180ms ease,
			box-shadow 180ms ease;
	}
	.button svg {
		height: 1.1rem;
		width: 1.1rem;
	}
	.button:hover {
		transform: translateY(-2px);
	}
	.button-primary {
		background: var(--accent);
		box-shadow: 0 8px 18px rgba(30, 128, 255, 18%);
		color: #ffffff;
	}
	.button-primary:hover {
		background: var(--accent-strong);
		color: #ffffff;
	}
	.button-secondary {
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text);
	}
	.button-secondary:hover {
		border-color: rgba(30, 128, 255, 34%);
		color: var(--accent);
	}
	.hero-visual {
		display: grid;
		place-items: center;
		position: relative;
	}
	.avatar-orbit {
		animation: slow-spin 54s linear infinite;
		border: 1px dashed var(--border);
		border-radius: 999px;
		height: 21rem;
		position: absolute;
		width: 21rem;
	}
	.avatar-frame {
		background: linear-gradient(135deg, var(--accent), #14c9c9);
		border-radius: 999px;
		padding: 5px;
		position: relative;
	}
	.avatar-frame img {
		aspect-ratio: 1;
		border: 8px solid #ffffff;
		border-radius: 999px;
		display: block;
		object-fit: cover;
		width: 18rem;
	}
	.section-block {
		background: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
		border-bottom: 1px solid #e4e6eb;
		margin: 0;
		padding: 88px var(--home-inline);
		position: relative;
		scroll-margin-top: 6rem;
		width: 100%;
	}
	.section-block:nth-of-type(3) {
		background: linear-gradient(180deg, #f7f8fa 0%, #ffffff 100%);
	}
	.section-block:nth-of-type(4) {
		background: linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%);
	}
	.section-heading {
		margin: 0 auto 3rem;
		max-width: 680px;
		text-align: center;
	}
	.section-heading h2 {
		margin-bottom: 0.75rem;
	}
	.section-heading p:not(.eyebrow) {
		color: var(--muted);
		margin: 0;
	}
	.post-grid,
	.project-grid {
		display: grid;
		gap: 1.4rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.post-card,
	.project-card,
	.platform-card,
	.stat-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		box-shadow: 0 1px 2px rgba(29, 33, 41, 3%);
	}
	.post-card,
	.project-card {
		color: var(--text);
		overflow: hidden;
		text-decoration: none;
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			box-shadow 180ms ease;
	}
	.post-card:hover,
	.project-card:hover {
		border-color: rgba(30, 128, 255, 34%);
		box-shadow: var(--box-shadow);
		color: var(--text);
		transform: translateY(-3px);
	}
	.post-card img,
	.project-card img {
		aspect-ratio: 16 / 9;
		display: block;
		object-fit: cover;
		transition: transform 360ms ease;
		width: 100%;
	}
	.post-card:hover img,
	.project-card:hover img {
		transform: scale(1.04);
	}
	.card-body {
		padding: 1.25rem;
	}
	.card-body .post-date,
	.project-kicker {
		align-items: center;
		color: var(--muted);
		display: flex;
		flex-wrap: wrap;
		font-size: 0.82rem;
		font-weight: 700;
		gap: 0.35rem;
		margin-bottom: 0.7rem;
	}
	.card-body .post-date span:first-child {
		color: var(--accent);
	}
	.card-body h3 {
		font-size: 1.08rem;
		margin-bottom: 0.65rem;
	}
	.card-body p:not(.post-date) {
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.7;
		margin: 0;
	}
	.section-action {
		margin-top: 2rem;
		text-align: center;
	}
	.text-link {
		align-items: center;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-bright);
		display: inline-flex;
		font-weight: 800;
		padding: 0.78rem 1.1rem;
		text-decoration: none;
		transition:
			border-color 180ms ease,
			color 180ms ease,
			transform 180ms ease;
	}
	.text-link:hover {
		border-color: rgba(30, 128, 255, 34%);
		color: var(--accent);
		transform: translateY(-1px);
	}
	.stats-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-bottom: 1.4rem;
	}
	.stat-card {
		padding: 1.25rem;
	}
	.stat-card span,
	.stat-card small {
		color: var(--muted);
		display: block;
		font-size: 0.86rem;
	}
	.stat-card strong {
		color: var(--text-bright);
		display: block;
		font-size: 2rem;
		line-height: 1.1;
		margin: 0.45rem 0;
	}
	.platform-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.platform-card {
		display: grid;
		gap: 1rem;
		grid-template-columns: 3rem 1fr;
		padding: 1.2rem;
	}
	.platform-mark {
		align-items: center;
		background: var(--accent-soft);
		border: 1px solid rgba(30, 128, 255, 18%);
		border-radius: 8px;
		color: var(--accent);
		display: flex;
		font-weight: 900;
		height: 3rem;
		justify-content: center;
		width: 3rem;
	}
	.platform-card h3 {
		font-size: 1rem;
		margin-bottom: 0.15rem;
	}
	.platform-card p {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0.5rem 0 0;
	}
	.platform-card .handle {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		margin: 0;
	}
	.platform-card span {
		color: var(--muted-soft);
		display: block;
		font-size: 0.78rem;
		font-weight: 800;
		margin-top: 0.85rem;
	}
	.mini-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 1rem;
	}
	.mini-tags span {
		background: var(--surface-raised);
		border: 1px solid var(--border-soft);
		border-radius: 999px;
		color: var(--text);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.35rem 0.55rem;
	}
	@keyframes slow-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.avatar-orbit {
			animation: none;
		}
		* {
			scroll-behavior: auto;
		}
	}
	@media (max-width: 960px) {
		.hero-section {
			gap: 3rem;
			grid-template-columns: 1fr;
			min-height: 0;
			padding: 56px var(--home-inline) 72px;
			text-align: center;
		}
		.hero-copy {
			order: 2;
		}
		.hero-visual {
			order: 1;
		}
		.hero-description,
		.skill-list {
			margin-left: auto;
			margin-right: auto;
		}
		.hero-actions,
		.skill-list {
			justify-content: center;
		}
		.post-grid,
		.project-grid,
		.platform-grid {
			grid-template-columns: 1fr 1fr;
		}
		.stats-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 640px) {
		.home-page {
			--home-inline: 14px;
		}
		.hero-section,
		.section-block {
			padding: 52px var(--home-inline);
		}
		.hero-copy h1 {
			font-size: 2.25rem;
		}
		.hero-copy h1 small {
			font-size: 1.55rem;
		}
		.hero-description {
			font-size: 1rem;
		}
		.avatar-orbit {
			height: 15rem;
			width: 15rem;
		}
		.avatar-frame img {
			width: 12rem;
		}
		.post-grid,
		.project-grid,
		.platform-grid,
		.stats-grid {
			grid-template-columns: 1fr;
		}
		.platform-card {
			grid-template-columns: 2.7rem 1fr;
		}
	}
</style>
