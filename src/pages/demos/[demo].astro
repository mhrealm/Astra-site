---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import DemoRenderer from '../../components/DemoRenderer.astro'
import { SITE_TITLE } from '../../consts'
import { getDemosFromPosts, type DemoEntry } from '../../data/demos'

export async function getStaticPaths() {
  return getDemosFromPosts(await getCollection('blog')).map((demo) => ({
    params: { demo: demo.slug },
    props: { demo },
  }))
}

interface Props {
  demo: DemoEntry
}

const { demo } = Astro.props
const noStageScrollDemoSlugs = new Set([
  'animation-car-showcase-basic',
  'animation-car-showcase-interactive',
])
const shouldLockStageScroll = noStageScrollDemoSlugs.has(demo.slug)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${demo.title} | ${SITE_TITLE}`} description={demo.description} />
    <style>
      .demo-main {
        display: flex;
        flex: 1;
        flex-direction: column;
        margin: 0;
        max-width: 100%;
        min-height: 0;
        overflow: hidden;
        padding: 0;
        width: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        height: 100dvh;
        min-height: 0;
        overflow: hidden;
      }

      .demo-header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex: 0 0 auto;
        height: 60px;
      }

      .demo-header-inner {
        align-items: center;
        display: flex;
        gap: 1rem;
        height: 100%;
        justify-content: space-between;
        margin: 0 auto;
        width: min(1120px, calc(100% - 32px));
      }

      .demo-title h1 {
        margin: 0;
      }

      .demo-title h1 {
        color: var(--text-bright);
        font-size: 1.25rem;
        line-height: 1.3;
      }

      .demo-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        justify-content: flex-end;
      }

      .demo-links a {
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--muted);
        font-size: 0.86rem;
        font-weight: 800;
        line-height: 1;
        padding: 0.65rem 0.85rem;
        text-decoration: none;
      }

      .demo-links a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .demo-stage {
        background: var(--bg);
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      .demo-stage :global(astro-island) {
        display: block;
        height: 100%;
        min-height: 0;
      }

      .demo-stage--locked {
        overflow: hidden;
      }

      @media (max-width: 720px) {
        .demo-header {
          height: auto;
        }

        .demo-header-inner {
          align-items: flex-start;
          flex-direction: column;
          padding: 1rem 0;
        }

        .demo-links {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <main class="demo-main">
      <section class="demo-header">
        <div class="demo-header-inner">
          <div class="demo-title">
            <h1>{demo.title}</h1>
          </div>
          <nav class="demo-links" aria-label="演示导航">
            {demo.articleSlug && <a href={`/blog/${demo.articleSlug}/`}>返回文章</a>}
            <a href={`/demos/${demo.slug}/source/`}>查看源码</a>
          </nav>
        </div>
      </section>
      <section
        class:list={['demo-stage', { 'demo-stage--locked': shouldLockStageScroll }]}
        aria-label={`${demo.title} 演示`}
      >
        <DemoRenderer demo={demo} />
      </section>
    </main>
  </body>
</html>
