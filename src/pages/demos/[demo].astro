---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import DemoRenderer from '../../components/DemoRenderer.astro'
import { SITE_TITLE } from '../../consts'
import { getDemosFromPosts, type DemoEntry } from '../../data/demos'

export async function getStaticPaths() {
  return getDemosFromPosts(await getCollection('blog')).map((demo) => ({
    params: { demo: demo.slug },
    props: { demo },
  }))
}

interface Props {
  demo: DemoEntry
}

const { demo } = Astro.props
const noStageScrollDemoSlugs = new Set([
  'animation-car-showcase-basic',
  'animation-car-showcase-interactive',
])
const shouldLockStageScroll = noStageScrollDemoSlugs.has(demo.slug)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${demo.title} | ${SITE_TITLE}`} description={demo.description} />
    <style>
      :global(:root) {
        --base: 1920;
      }

      :global(html) {
        font-size: calc(10 / var(--base) * 100vw);
      }

      .demo-main {
        display: flex;
        flex: 1;
        flex-direction: column;
        margin: 0;
        max-width: 100%;
        min-height: 0;
        overflow: hidden;
        padding: 0;
        width: 100%;
      }

      body {
        display: flex;
        flex-direction: column;
        height: 100dvh;
        min-height: 0;
        overflow: hidden;
      }

      .demo-header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex: 0 0 auto;
        height: 60px;
      }

      .demo-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        height: 100%;
        justify-content: space-between;
        margin: 0 auto;
        width: min(1120px, calc(100% - 32px));
      }

      .demo-title h1 {
        color: var(--text-bright);
        font-size: 20px;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .demo-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
      }

      .demo-links a {
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 800;
        line-height: 1;
        padding: 10px 14px;
        text-decoration: none;
      }

      .demo-links a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .demo-stage {
        background: var(--bg);
        flex: 1;
        min-height: 0;
        overflow: auto;
        overscroll-behavior: contain;
      }

      .demo-stage :global(astro-island) {
        display: block;
        height: 100%;
        min-height: 0;
      }

      .demo-stage--locked {
        overflow: hidden;
      }

      @media (max-width: 1023px), (orientation: portrait) {
        :global(:root) {
          --base: 428;
        }
      }

      @media (max-width: 720px) {
        .demo-header-inner {
          flex-direction: row;
          gap: 10px;
          width: calc(100% - 20px);
        }

        .demo-title {
          flex: 1 1 0;
          overflow: hidden;
        }

        .demo-title h1 {
          display: -webkit-box;
          font-size: 16px;
          line-height: 1.2;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: normal;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
        }

        .demo-links {
          flex: 0 0 auto;
          flex-wrap: nowrap;
          gap: 6px;
        }

        .demo-links a {
          border-radius: 5px;
          flex: 0 0 auto;
          font-size: 12px;
          padding: 8px 9px;
          white-space: nowrap;
        }
      }
    </style>
  </head>
  <body>
    <main class="demo-main">
      <section class="demo-header">
        <div class="demo-header-inner">
          <div class="demo-title">
            <h1>{demo.title}</h1>
          </div>
          <nav class="demo-links" aria-label="演示导航">
            {demo.articleSlug && <a href={`/blog/${demo.articleSlug}/`}>返回文章</a>}
            <a href={`/demos/${demo.slug}/source/`}>查看源码</a>
          </nav>
        </div>
      </section>
      <section
        class:list={['demo-stage', { 'demo-stage--locked': shouldLockStageScroll }]}
        aria-label={`${demo.title} 演示`}
      >
        <DemoRenderer demo={demo} />
      </section>
    </main>
  </body>
</html>
