---
import { readFileSync } from 'node:fs'
import path from 'node:path'
import { getCollection } from 'astro:content'
import { format } from 'prettier'
import { codeToHtml } from 'shiki'
import BaseHead from '../../components/BaseHead.astro'
import HeaderMenu from '../../components/HeaderMenu.astro'
import { SITE_TITLE } from '../../consts'
import { getDemosFromPosts, type DemoEntry } from '../../data/demos'

export async function getStaticPaths() {
  return getDemosFromPosts(await getCollection('blog')).map((demo) => ({
    params: { source: `${demo.slug}/source` },
    props: { demo },
  }))
}

interface Props {
  demo: DemoEntry
}

const { demo } = Astro.props
const sourceRoot = path.resolve(process.cwd(), demo.sourceRoot)
const languageByExtension: Record<string, string> = {
  '.vue': 'vue',
  '.tsx': 'tsx',
  '.jsx': 'jsx',
  '.ts': 'ts',
  '.js': 'js',
  '.mjs': 'js',
  '.md': 'md',
  '.css': 'css',
  '.less': 'less',
}

const parserByExtension: Record<string, string> = {
  '.vue': 'vue',
  '.tsx': 'typescript',
  '.jsx': 'babel',
  '.ts': 'typescript',
  '.js': 'babel',
  '.mjs': 'babel',
  '.md': 'markdown',
  '.css': 'css',
  '.less': 'less',
}

async function formatSource(content: string, extension: string) {
  const parser = parserByExtension[extension]

  if (!parser) {
    return content.trimEnd()
  }

  try {
    return (
      await format(content, {
        parser,
        printWidth: 100,
        semi: false,
        singleQuote: true,
        trailingComma: 'all',
      })
    ).trimEnd()
  } catch {
    return content.trimEnd()
  }
}

function normalizeHighlightedCode(html: string) {
  return html.replaceAll('</span>\n<span class="line">', '</span><span class="line">')
}

const files = await Promise.all(
  demo.sourceFiles.map(async (filePath) => {
    const extension = path.extname(filePath)
    const absolutePath = path.resolve(sourceRoot, filePath)

    if (!absolutePath.startsWith(sourceRoot + path.sep) && absolutePath !== sourceRoot) {
      throw new Error(`Unexpected source path: ${filePath}`)
    }

    const language = languageByExtension[extension] ?? 'text'
    const content = await formatSource(readFileSync(absolutePath, 'utf-8'), extension)

    return {
      path: filePath,
      absolutePath,
      language,
        html: normalizeHighlightedCode(
          await codeToHtml(content, {
            lang: language,
            themes: {
              light: 'github-light',
              dark: 'github-dark',
            },
            defaultColor: false,
          }),
        ),
    }
  }),
)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`${demo.title} 源码 | ${SITE_TITLE}`} description={demo.description} />
    <style>
      :global(html),
      :global(body.source-page) {
        height: 100%;
        overflow: hidden;
      }

      :global(body.source-page) {
        background: var(--bg);
      }

      .source-viewer {
        display: flex;
        flex-direction: column;
        height: 100vh;
        margin: 0;
        min-height: 0;
        overflow: hidden;
        width: 100%;
        background-color: var(--bg);
      }

      .source-header {
        position: relative;
        z-index: 20;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        flex: 0 0 auto;
        height: 60px;
      }

      .source-header-inner {
        align-items: center;
        display: flex;
        gap: 16px;
        height: 100%;
        justify-content: space-between;
        margin: 0 auto;
        width: min(1120px, calc(100% - 32px));
      }

      .file-tabs {
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
        gap: 0.45rem;
        overflow-x: auto;
        padding: 0.1rem;
        scrollbar-width: none;
      }

      .file-tabs::-webkit-scrollbar {
        display: none;
      }

      .file-tab {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        gap: 0.5rem;
        max-width: 280px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        font: inherit;
        line-height: 1;
        padding: 0.5rem 0.68rem;
        transition:
          color 180ms ease,
          background-color 180ms ease;
      }

      .file-tab:hover {
        background: var(--accent-soft);
        color: var(--accent);
      }

      .file-tab.is-active {
        background: rgba(var(--accent-rgb), 0.08);
        color: var(--accent);
      }

      .file-tab strong {
        display: block;
        min-width: 0;
        overflow: hidden;
        color: inherit;
        font-size: 0.82rem;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .file-icon {
        position: relative;
        flex: 0 0 auto;
        width: 1.18rem;
        height: 1.18rem;
        border: 1px solid currentColor;
        border-radius: 4px;
        opacity: 0.72;
      }

      .file-icon::before,
      .file-icon::after {
        position: absolute;
        content: '';
      }

      .file-icon::before {
        top: 0.32rem;
        left: 0.28rem;
        width: 0.52rem;
        height: 1.5px;
        background: currentColor;
        box-shadow: 0 0.22rem 0 currentColor;
      }

      .file-icon::after {
        top: -1px;
        right: -1px;
        width: 0.34rem;
        height: 0.34rem;
        border-bottom: 1px solid currentColor;
        border-left: 1px solid currentColor;
        border-radius: 0 3px 0 2px;
        background: var(--bg);
      }

      .file-tab.is-active .file-icon::after {
        background: var(--accent-soft);
      }

      .copy-code-button,
      .source-action-link {
        align-items: center;
        background: transparent;
        border: 0;
        border-radius: 0;
        color: var(--muted);
        cursor: pointer;
        display: inline-flex;
        gap: 0.4rem;
        font: inherit;
        font-size: 0.8rem;
        font-weight: 500;
        line-height: 1;
        padding: 0.35rem 0.1rem;
        text-decoration: none;
        white-space: nowrap;
        transition: color 160ms ease;
      }

      .copy-code-button {
        font-size: 14px;
        padding: 10px 14px;
      }

      .copy-code-button:hover,
      .source-action-link:hover {
        color: var(--accent);
      }

      .copy-code-button.is-copied {
        color: var(--accent);
      }

      .source-action-link.primary {
        color: var(--text-bright);
      }

      .source-action-link.primary:hover {
        color: var(--accent);
      }

      .copy-icon {
        position: relative;
        width: 0.85rem;
        height: 0.85rem;
      }

      .copy-icon::before,
      .copy-icon::after {
        position: absolute;
        content: '';
        width: 0.52rem;
        height: 0.62rem;
        border: 1.5px solid currentColor;
        border-radius: 2px;
      }

      .copy-icon::before {
        top: 0.16rem;
        left: 0.08rem;
        opacity: 0.42;
      }

      .copy-icon::after {
        top: 0;
        right: 0.06rem;
        background: var(--bg-elevated);
      }

      .copy-code-button.is-copied .copy-icon::after {
        background: var(--accent-soft);
      }

      .source-code-viewport {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        background: var(--bg-elevated);
        border-radius: 8px;
        margin: 16px auto 20px;
        max-width: 960px;
        width: calc(100% - 40px);
      }

      .source-code-panel,
      .source-code {
        min-height: 100%;
      }

      .source-code-panel[hidden] {
        display: none;
      }

      .source-code :global(pre.shiki) {
        border: 0 !important;
        overflow: visible;
        margin: 0;
        min-height: 100%;
        max-height: none;
        background: var(--bg-elevated) !important;
        color: var(--shiki-dark);
        font-size: 0.84rem;
        line-height: 1.42;
        padding: 0.72rem 0;
        white-space: normal;
      }

      :global(html[data-theme='dark']) .source-code :global(pre.shiki),
      :global(html[data-theme='dark']) .source-code :global(pre.shiki span) {
        color: var(--shiki-dark) !important;
      }

      :global(html[data-theme='light']) .source-code :global(pre.shiki),
      :global(html[data-theme='light']) .source-code :global(pre.shiki span) {
        color: var(--shiki-light) !important;
      }

      .source-code :global(code) {
        counter-reset: source-line;
        display: block;
        font-family: 'Fira Code', 'JetBrains Mono', Consolas, 'Liberation Mono', monospace;
        min-width: max-content;
      }

      .source-code :global(.line) {
        box-sizing: border-box;
        display: block;
        min-height: 1.42em;
        padding: 0 1.2rem 0 0;
        white-space: pre;
      }

      .source-code :global(.line:hover) {
        background: var(--surface-raised);
      }

      .source-code :global(.line::before) {
        counter-increment: source-line;
        content: counter(source-line);
        display: inline-block;
        margin-right: 0.95rem;
        padding-right: 0.8rem;
        width: 3.35rem;
        color: var(--muted-soft);
        text-align: right;
        user-select: none;
      }

      @media (max-width: 720px) {
        .source-viewer {
          max-width: none;
          width: 100vw;
        }

        .source-header-inner {
          gap: 12px;
          width: calc(100% - 24px);
        }

        .source-code-viewport {
          width: calc(100% - 24px);
        }
      }
    </style>
  </head>
  <body class="source-page">
    <main class="source-viewer" data-source-viewer>
      <section class="source-header">
        <div class="source-header-inner">
          <div class="file-tabs" role="tablist" aria-label="源码文件">
            {
              files.map((file, index) => (
                <button
                  class={`file-tab${index === 0 ? ' is-active' : ''}`}
                  type="button"
                  id={`source-tab-${index}`}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`source-panel-${index}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-source-tab
                >
                  <span class="file-icon" aria-hidden="true" />
                  <strong>{file.path}</strong>
                </button>
              ))
            }
          </div>
          <HeaderMenu
            label="打开源码操作"
            menuId="source-menu-list"
            ariaLabel="源码操作"
            buttonColor="var(--text-bright)"
            desktopGap="10px"
            mobileJustifySelf="end"
            panelBorder="var(--border)"
            panelMinWidth="128px"
            variant="pill"
          >
            <button class="copy-code-button" type="button" data-copy-button>
              <span class="copy-icon" aria-hidden="true"></span>
              <span data-copy-label>复制</span>
            </button>
            <a class="source-action-link primary" href={`/demos/${demo.slug}`}>预览效果</a>
            {
              demo.articleSlug && (
                <a class="source-action-link" href={`/blog/${demo.articleSlug}`}>
                  返回文章
                </a>
              )
            }
          </HeaderMenu>
        </div>
      </section>

      <div class="source-code-viewport">
        {
          files.map((file, index) => (
            <section
              class="source-code-panel"
              id={`source-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`source-tab-${index}`}
              data-source-panel
              hidden={index !== 0}
            >
              <div class="source-code" set:html={file.html} />
            </section>
          ))
        }
      </div>
      </main>

    <script>
      const writeToClipboard = async (text: string) => {
        if (!navigator.clipboard?.writeText) {
          throw new Error('Clipboard API is unavailable')
        }

        await navigator.clipboard.writeText(text)
      }

      const setCopyState = (button: Element, label: string, isCopied = false) => {
        const labelNode = button.querySelector('[data-copy-label]')
        if (labelNode) {
          labelNode.textContent = label
        } else {
          button.textContent = label
        }
        button.classList.toggle('is-copied', isCopied)
      }

      document.querySelectorAll<HTMLElement>('[data-source-viewer]').forEach((viewer) => {
        const tabs = [...viewer.querySelectorAll<HTMLButtonElement>('[data-source-tab]')]
        const panels = [...viewer.querySelectorAll<HTMLElement>('[data-source-panel]')]
        const copyButton = viewer.querySelector<HTMLButtonElement>('[data-copy-button]')
        let activeIndex = 0

        const activateFile = (index: number, shouldFocus = false) => {
          if (!tabs.length || !panels.length) {
            return
          }

          const nextIndex = (index + tabs.length) % tabs.length
          activeIndex = nextIndex

          tabs.forEach((tab, tabIndex) => {
            const isActive = tabIndex === nextIndex
            tab.classList.toggle('is-active', isActive)
            tab.setAttribute('aria-selected', String(isActive))
            tab.tabIndex = isActive ? 0 : -1
          })

          panels.forEach((panel, panelIndex) => {
            panel.hidden = panelIndex !== nextIndex
          })

          tabs[nextIndex]?.scrollIntoView({ block: 'nearest', inline: 'nearest' })

          if (shouldFocus) {
            tabs[nextIndex]?.focus()
          }
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activateFile(index))
          tab.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') {
              event.preventDefault()
              activateFile(activeIndex - 1, true)
            }

            if (event.key === 'ArrowRight') {
              event.preventDefault()
              activateFile(activeIndex + 1, true)
            }

            if (event.key === 'Home') {
              event.preventDefault()
              activateFile(0, true)
            }

            if (event.key === 'End') {
              event.preventDefault()
              activateFile(tabs.length - 1, true)
            }
          })
        })

        copyButton?.addEventListener('click', async () => {
          const activePanel = panels[activeIndex]
          const lines = activePanel?.querySelectorAll('.source-code .line') ?? []
          const code = [...lines].map((line) => line.textContent ?? '').join('\n')

          try {
            await writeToClipboard(code)
            setCopyState(copyButton, '已复制', true)
          } catch {
            setCopyState(copyButton, '复制失败')
          }

          window.setTimeout(() => {
            setCopyState(copyButton, '复制当前文件')
          }, 1600)
        })

        activateFile(activeIndex)
      })
    </script>
  </body>
</html>
