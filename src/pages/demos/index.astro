---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import CategoryTabs from '../../components/CategoryTabs.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts'
import { compareCategorySlug } from '../../data/categories'
import { getDemosFromPosts, type DemoEntry } from '../../data/demos'

const demos = getDemosFromPosts(await getCollection('blog'))
const categoryMap = new Map<
  string,
  { category: string; categorySlug: string; items: DemoEntry[] }
>()

for (const demo of demos) {
  const group = categoryMap.get(demo.categorySlug) ?? {
    category: demo.category,
    categorySlug: demo.categorySlug,
    items: [],
  }

  group.items.push(demo)
  categoryMap.set(demo.categorySlug, group)
}

const groups = [...categoryMap.values()]
  .map((group) => ({
    ...group,
    items: group.items.sort((a, b) => a.title.localeCompare(b.title, 'zh-CN')),
  }))
  .sort((a, b) => compareCategorySlug(a.categorySlug, b.categorySlug))

const allDemos = [...demos].sort(
  (a, b) =>
    compareCategorySlug(a.categorySlug, b.categorySlug) || a.title.localeCompare(b.title, 'zh-CN'),
)

const tabs = [
  {
    label: '全部',
    count: allDemos.length,
    value: 'all',
    id: 'demo-tab-all',
    controls: 'demo-panel-all',
    active: true,
    items: allDemos,
  },
  ...groups.map((group) => ({
    label: group.category,
    count: group.items.length,
    value: group.categorySlug,
    id: `demo-tab-${group.categorySlug}`,
    controls: `demo-panel-${group.categorySlug}`,
    active: false,
    items: group.items,
  })),
]
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`演示 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .site-main {
        width: min(1120px, calc(100% - 32px));
      }

      .demo-hero {
        margin: 0 auto 1.5rem;
        max-width: 720px;
        text-align: center;
      }

      .demo-hero p,
      .demo-hero h1 {
        margin: 0;
      }

      .demo-hero p {
        color: var(--accent);
        font-size: 0.84rem;
        font-weight: 800;
      }

      .demo-hero h1 {
        font-size: 2.3rem;
        line-height: 1.2;
        margin-top: 0.55rem;
      }
      .demo-tabs-area {
        margin: 0 auto;
      }

      .demo-panel[hidden] {
        display: none;
      }

      .demo-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: var(--box-shadow);
        overflow: hidden;
      }

      .demo-item {
        display: grid;
        gap: 0.9rem;
        grid-template-columns: minmax(0, 1fr) auto;
        padding: 1rem 1.1rem;
      }

      .demo-item + .demo-item {
        border-top: 1px solid var(--border);
      }

      .demo-copy h3,
      .demo-copy p {
        margin: 0;
      }

      .demo-copy h3 {
        color: var(--text-bright);
        font-size: 1rem;
        line-height: 1.4;
      }

      .demo-copy p {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.7;
        margin-top: 0.35rem;
      }

      .demo-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        justify-content: flex-end;
      }

      .demo-actions a,
      .demo-actions span {
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: 0.82rem;
        font-weight: 800;
        line-height: 1;
        padding: 0.58rem 0.72rem;
        text-decoration: none;
      }

      .demo-actions a {
        color: var(--muted);
      }

      .demo-actions a.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }

      .demo-actions a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      .demo-actions a.primary:hover {
        background: var(--accent-strong);
        border-color: var(--accent-strong);
        color: #fff;
      }

      .demo-actions span {
        color: var(--muted-soft);
      }

      @media (max-width: 720px) {
        .site-main {
          width: min(100% - 24px, 1120px);
        }

        .demo-item {
          grid-template-columns: 1fr;
        }

        .demo-actions {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="site-main">
      <section class="demo-hero">
        <p>Demos</p>
        <h1>示例预览</h1>
      </section>

      <section class="demo-tabs-area" data-demo-tabs>
        <CategoryTabs items={tabs} ariaLabel="演示分类" mode="button" />

        {
          tabs.map((tab, index) => (
            <section
              id={tab.controls}
              class="demo-panel"
              role="tabpanel"
              aria-labelledby={tab.id}
              data-demo-panel={tab.value}
              hidden={index !== 0}
            >
              <div class="demo-list">
                {tab.items.map((demo) => (
                  <article class="demo-item">
                    <div class="demo-copy">
                      <h3>{demo.title}</h3>
                      <p>{demo.description}</p>
                    </div>
                    <div class="demo-actions">
                      <a class="primary" href={`/demos/${demo.slug}/`}>
                        预览
                      </a>
                      <a href={`/demos/${demo.slug}/source/`}>源码</a>
                      {demo.articleSlug ? (
                        <a href={`/blog/${demo.articleSlug}/`}>文章</a>
                      ) : (
                        <span>待补文章</span>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </section>
    </main>
    <Footer />

    <script>
      document.querySelectorAll<HTMLElement>('[data-demo-tabs]').forEach((root) => {
        const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-category-tab]')]
        const panels = [...root.querySelectorAll<HTMLElement>('[data-demo-panel]')]

        const activateTab = (value: string, shouldFocus = false) => {
          tabs.forEach((tab) => {
            const isActive = tab.dataset.categoryTab === value
            tab.classList.toggle('is-active', isActive)
            tab.setAttribute('aria-selected', isActive ? 'true' : 'false')
            tab.tabIndex = isActive ? 0 : -1

            if (isActive && shouldFocus) {
              tab.focus()
            }
          })

          panels.forEach((panel) => {
            panel.hidden = panel.dataset.demoPanel !== value
          })
        }

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => {
            const value = tab.dataset.categoryTab

            if (value) {
              activateTab(value)
            }
          })

          tab.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') {
              return
            }

            event.preventDefault()

            const direction = event.key === 'ArrowRight' ? 1 : -1
            const nextIndex = (index + direction + tabs.length) % tabs.length
            const nextValue = tabs[nextIndex]?.dataset.categoryTab

            if (nextValue) {
              activateTab(nextValue, true)
            }
          })
        })
      })
    </script>
  </body>
</html>
