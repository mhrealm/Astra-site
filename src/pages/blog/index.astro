---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import BlogCategoryNav from '../../components/BlogCategoryNav.astro'
import BlogListingHero from '../../components/BlogListingHero.astro'
import BlogPostRow from '../../components/BlogPostRow.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts'
import { getCategorySummaries } from '../../data/categories'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const categories = getCategorySummaries(posts)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: min(1120px, calc(100% - 32px));
      }
      .post-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: var(--box-shadow);
        overflow: hidden;
      }
      @media (max-width: 640px) {
        main {
          width: min(100% - 24px, 1120px);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <BlogListingHero />

      <BlogCategoryNav categories={categories} total={posts.length} />

      <div class="post-list">
        {posts.map((post) => <BlogPostRow post={post} />)}
      </div>
    </main>
    <Footer />
  </body>
</html>
