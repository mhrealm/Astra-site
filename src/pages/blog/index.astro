---
import { getCollection } from 'astro:content'
import BaseHead from '../../components/BaseHead.astro'
import BlogCategoryNav from '../../components/BlogCategoryNav.astro'
import BlogListingHero from '../../components/BlogListingHero.astro'
import BlogPostRow from '../../components/BlogPostRow.astro'
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts'

const categoryOrder = [
  'performance',
  'javascript',
  'vue',
  'interaction',
  'animation',
  'canvas',
  'css-effects',
  'classic-replica',
  'uncategorized',
]

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)

const categoryMap = new Map<string, { name: string; slug: string; count: number }>()

for (const post of posts) {
  const slug = post.data.categorySlug ?? 'uncategorized'
  const current = categoryMap.get(slug)
  if (current) {
    current.count += 1
  } else {
    categoryMap.set(slug, {
      name: post.data.category ?? '未分类',
      slug,
      count: 1,
    })
  }
}

const categories = [...categoryMap.values()].sort((a, b) => {
  const aIndex = categoryOrder.indexOf(a.slug)
  const bIndex = categoryOrder.indexOf(b.slug)
  return (aIndex === -1 ? 99 : aIndex) - (bIndex === -1 ? 99 : bIndex)
})
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={`博客 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: min(1120px, calc(100% - 32px));
      }
      .post-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: var(--box-shadow);
        overflow: hidden;
      }
      @media (max-width: 640px) {
        main {
          width: min(100% - 24px, 1120px);
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <BlogListingHero />

      <BlogCategoryNav categories={categories} total={posts.length} />

      <div class="post-list">
        {posts.map((post) => <BlogPostRow post={post} />)}
      </div>
    </main>
    <Footer />
  </body>
</html>
