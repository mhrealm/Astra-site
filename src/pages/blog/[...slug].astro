---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import BlogPost from '../../layouts/BlogPost.astro'
import { getBlogSlug } from '../../data/blogSlugs'
import { getDemoForPost } from '../../data/demos'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: getBlogSlug(post) },
    props: post,
  }))
}
type Props = CollectionEntry<'blog'>

const post = Astro.props
const { Content, headings } = await render(post)
const demo = getDemoForPost(post)
const postSlug = getBlogSlug(post)
const relatedPosts = (await getCollection('blog'))
  .filter(
    (candidate) =>
      candidate.data.categorySlug === post.data.categorySlug && getBlogSlug(candidate) !== postSlug,
  )
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5)
---

<BlogPost {...post.data} demo={demo} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</BlogPost>
