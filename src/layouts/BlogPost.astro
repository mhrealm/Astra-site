---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import BlogDemoPanel from '../components/BlogDemoPanel.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { SITE_TITLE } from '../consts'
import type { DemoEntry } from '../data/demos'

type Props = CollectionEntry<'blog'>['data'] & {
  demo?: DemoEntry
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  categorySlug,
  tags = [],
  difficulty,
  demo,
} = Astro.props
---

<html lang="zh-CN">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
    <style>
      main {
        max-width: 100%;
        margin: 0;
        padding-top: 24px;
        width: 100%;
      }
      article {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: var(--box-shadow);
        margin: 0 auto;
        overflow: hidden;
        width: min(100% - 32px, 1020px);
      }
      .hero-image {
        border-bottom: 1px solid var(--border);
        overflow: hidden;
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        width: 100%;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 3rem 0 2rem;
        color: var(--text);
      }
      .title {
        margin-bottom: 2rem;
        text-align: center;
      }
      .title h1 {
        font-size: 2.6rem;
        line-height: 1.15;
        margin: 0 0 1rem;
      }
      .date {
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.7rem;
      }
      .last-updated-on {
        font-style: italic;
        font-weight: 500;
        margin-top: 0.25rem;
      }
      .entry-meta {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin: 1rem auto 0;
      }
      .entry-meta a,
      .entry-meta span {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
        padding: 0.4rem 0.62rem;
        text-decoration: none;
      }
      .entry-meta a {
        background: var(--accent-soft);
        border-color: rgba(30, 128, 255, 18%);
        color: var(--accent);
      }
      .entry-meta a:hover {
        border-color: rgba(30, 128, 255, 34%);
        color: var(--accent-strong);
      }
      .prose :global(a) {
        color: var(--accent);
      }
      .prose :global(h2),
      .prose :global(h3) {
        margin-top: 2rem;
      }
      @media (max-width: 640px) {
        main {
          padding-top: 16px;
        }
        .prose {
          max-width: 100%;
          padding-top: 2rem;
        }
        .title h1 {
          font-size: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <div class="entry-meta" aria-label="文章分类信息">
              <a href={`/blog/category/${categorySlug ?? 'uncategorized'}/`}
                >{category ?? '未分类'}</a
              >
              {difficulty && <span>难度 {difficulty}/5</span>}
              {tags.map((tag) => <span>{tag}</span>)}
            </div>
            <hr />
          </div>
          <BlogDemoPanel demo={demo} />
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
