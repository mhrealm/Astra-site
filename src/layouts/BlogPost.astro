---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import BaseHead from '../components/BaseHead.astro'
import BlogDemoPanel from '../components/BlogDemoPanel.astro'
import BlogRelatedPosts from '../components/BlogRelatedPosts.astro'
import BlogToc from '../components/BlogToc.astro'
import DifficultyStars from '../components/DifficultyStars.astro'
import Footer from '../components/Footer.astro'
import FormattedDate from '../components/FormattedDate.astro'
import Header from '../components/Header.astro'
import { SITE_TITLE } from '../consts'
import type { DemoEntry } from '../data/demos'

interface MarkdownHeading {
  depth: number
  slug: string
  text: string
}

type Props = Partial<CollectionEntry<'blog'>['data']> &
  Pick<CollectionEntry<'blog'>['data'], 'title' | 'description' | 'pubDate'> & {
    demo?: DemoEntry
    headings?: MarkdownHeading[]
    relatedPosts?: CollectionEntry<'blog'>[]
  }

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  category,
  categorySlug,
  tags = [],
  difficulty,
  demo,
  headings = [],
  relatedPosts = [],
} = Astro.props

const tocHeadings = headings.filter((heading) => heading.depth === 2)
const hasToc = tocHeadings.length > 0
const hasSidebar = hasToc || relatedPosts.length > 0
---

<html lang="zh-CN">
  <head>
    <BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
    <style>
      :global(html),
      :global(body) {
        overflow-x: clip;
        overflow-y: visible;
      }
      .post-main {
        background-color: var(--bg);
        max-width: 100%;
        margin: 0;
        padding: 24px 0 72px;
        width: 100%;
      }
      .post-shell {
        display: grid;
        gap: 24px;
        grid-template-columns: minmax(0, 1020px);
        margin: 0 auto;
        position: relative;
        width: min(100% - 32px, 1020px);
      }
      .post-shell.with-sidebar {
        align-items: start;
        grid-template-columns: minmax(0, 860px) 280px;
        width: min(100% - 32px, 1180px);
      }
      article {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        box-shadow: var(--box-shadow);
        overflow: hidden;
        width: 100%;
      }
      .hero-image {
        border-bottom: 1px solid var(--border);
        overflow: hidden;
        width: 100%;
      }
      .hero-image img {
        display: block;
        margin: 0 auto;
        width: 100%;
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 48px);
        margin: 0 auto;
        padding: 3rem 0 2rem;
        color: var(--text);
      }
      .title {
        margin-bottom: 2rem;
        text-align: center;
      }
      .title h1 {
        font-size: 2.6rem;
        line-height: 1.15;
        margin: 0 0 1rem;
      }
      .date {
        color: var(--muted);
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.7rem;
      }
      .last-updated-on {
        font-style: italic;
        font-weight: 500;
        margin-top: 0.25rem;
      }
      .entry-meta {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin: 1rem auto 0;
      }
      .entry-meta a,
      .entry-meta span {
        background: var(--surface-raised);
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1;
        padding: 0.4rem 0.62rem;
        text-decoration: none;
      }
      .entry-meta a {
        background: var(--accent-soft);
        border-color: rgba(30, 128, 255, 18%);
        color: var(--accent);
      }
      .entry-meta a:hover {
        border-color: rgba(30, 128, 255, 34%);
        color: var(--accent-strong);
      }
      .prose :global(a) {
        color: var(--accent);
      }
      .prose :global(h2),
      .prose :global(h3) {
        margin-top: 2rem;
        scroll-margin-top: 6rem;
      }
      .post-sidebar {
        align-self: start;
        display: grid;
        gap: 16px;
        max-height: calc(100vh - 112px);
        overflow-y: auto;
        padding-right: 2px;
        position: sticky;
        scrollbar-color: #cfd4dc transparent;
        scrollbar-width: thin;
        top: 88px;
      }
      .post-sidebar[hidden] {
        display: none;
      }
      .post-sidebar::-webkit-scrollbar {
        width: 6px;
      }
      .post-sidebar::-webkit-scrollbar-track {
        background: transparent;
      }
      .post-sidebar::-webkit-scrollbar-thumb {
        background: #d8dce3;
        border-radius: 999px;
      }
      .post-sidebar::-webkit-scrollbar-thumb:hover {
        background: #c6cbd4;
      }
      @media (max-width: 1100px) {
        .post-shell.with-sidebar {
          grid-template-columns: minmax(0, 720px);
          justify-content: center;
          width: min(100% - 32px, 1020px);
        }
        .post-sidebar {
          display: none;
        }
      }
      @media (max-width: 640px) {
        .post-main {
          padding: 16px 0 56px;
        }
        .prose {
          max-width: calc(100% - 32px);
          padding-top: 2rem;
        }
        .title h1 {
          font-size: 2rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main class="post-main">
      <div class:list={['post-shell', { 'with-sidebar': hasSidebar }]}>
        <article>
          <div class="hero-image">
            {heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
          </div>
          <div class="prose">
            <div class="title">
              <div class="date">
                <FormattedDate date={pubDate} />
                {
                  updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )
                }
              </div>
              <h1>{title}</h1>
              <div class="entry-meta" aria-label="文章分类信息">
                <a href={`/blog/category/${categorySlug ?? 'uncategorized'}/`}
                  >{category ?? '未分类'}</a
                >
                {difficulty && <DifficultyStars value={difficulty} variant="chip" />}
                {tags.map((tag) => <span>{tag}</span>)}
              </div>
              <hr />
            </div>
            <BlogDemoPanel demo={demo} />
            <slot />
          </div>
        </article>
        <div class="post-sidebar" role="complementary" aria-label="文章侧栏" hidden={!hasSidebar}>
          {hasToc && <BlogToc headings={tocHeadings} />}
          <BlogRelatedPosts posts={relatedPosts} />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
